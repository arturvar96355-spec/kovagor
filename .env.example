# Эти настройки создаются интерактивно: bash scripts/init-env.sh (описание всех переменных — ниже).

# Домен и адрес сайта
SITE_DOMAIN=kovagor.ru
NEXT_PUBLIC_SITE_URL=https://kovagor.ru

# Закрыть сайт от поисковиков на время доработки (удалить строку, когда сайт готов)
NEXT_PUBLIC_NOINDEX=1

# Telegram-бот: заявки и переписка менеджеров с клиентами (docs/TELEGRAM.md)
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @, например kovagor_bot
TELEGRAM_BOT_USERNAME=
# Номер приватной супергруппы менеджеров с включёнными темами, вида -100123...
TELEGRAM_GROUP_ID=
# Любая случайная строка от 16 символов: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Заявки на email — резервный канал (bash scripts/set-mail.sh); пароль — пароль приложения почтового сервиса
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# LEAD_EMAIL_TO=

# Если сервер в РФ и Telegram недоступен — ретранслятор за рубежом (bash scripts/set-relay.sh tg.kovagor.ru)
# TELEGRAM_API_BASE=https://tg.kovagor.ru
# TELEGRAM_WEBHOOK_URL=https://tg.kovagor.ru/hook

# Упрощённый режим без переписки (только уведомление в чат) — вместо четырёх переменных выше:
# TELEGRAM_CHAT_ID=

# Заявки в Telegram-бота: сайт хранит заявку, а бот (Cloudflare Worker) забирает её по ссылке t.me/бот?start=… (bash scripts/set-lead-secret.sh)
# LEAD_PULL_SECRET=
