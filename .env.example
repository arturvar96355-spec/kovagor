# Скопируйте в .env на сервере и заполните
SITE_DOMAIN=kovagor.ru
NEXT_PUBLIC_SITE_URL=https://kovagor.ru

# --- Telegram-бот: заявки + переписка менеджеров с клиентами (см. docs/TELEGRAM.md) ---
TELEGRAM_BOT_TOKEN=            # от @BotFather
TELEGRAM_BOT_USERNAME=         # имя бота без @, например kovagor_bot
TELEGRAM_GROUP_ID=             # id приватной супергруппы менеджеров с включёнными темами, вида -100123…
TELEGRAM_WEBHOOK_SECRET=       # любая случайная строка 32+ символов: openssl rand -hex 24
DATA_DIR=./data                # где лежит bot.sqlite; на сервере — постоянный диск (в Docker: /app/data)

# Упрощённый режим без бота-переписки (только уведомление в чат) — вместо четырёх переменных выше:
# TELEGRAM_CHAT_ID=
