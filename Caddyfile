# Домен берётся из SITE_DOMAIN в .env (kovagor.ru). Caddy сам получает и продлевает HTTPS-сертификат.
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
  @www host www.{$SITE_DOMAIN}
  redir @www https://{$SITE_DOMAIN}{uri} permanent

  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  request_body max_size 1MB

  reverse_proxy app:3000 {
    header_up X-Real-IP {remote_host}
  }
}
